{
  "schema": 1,
  "name": "omp",
  "root": "~/.omp/agent",
  "reads": {
    "skills": [
      {"path": "~/.omp/agent/skills", "writable": true, "dedupe": "identical-bytes"},
      {"path": "~/.agents/skills", "writable": false, "dedupe": "identical-bytes"}
    ],
    "never_write": ["~/.omp/agent/extensions/**", "~/.omp/agent/config.yml.lock"]
  },
  "units": {
    "skill": {"frontmatter": "keep", "sidecar": null},
    "command": {"dir": "~/.omp/agent/commands", "format": "md-frontmatter"},
    "agent": null
  },
  "hide": {"method": "frontmatter-key", "key": "hide", "value": true},
  "models": {"source": "the modelRoles key in ~/.omp/agent/config.yml"},
  "instructions": {"path": "~/.omp/agent/AGENTS.md", "mode": "whole-file"},
  "hooks": {"session_end": null},
  "transcripts": {"format": "omp-jsonl", "root": "~/.omp/agent/sessions"}
}

{
  "schema": 1,
  "name": "codex",
  "root": "~/.codex",
  "reads": {
    "skills": [
      {"path": "~/.codex/skills", "writable": true, "dedupe": "none"},
      {"path": "~/.agents/skills", "writable": true, "dedupe": "none"}
    ],
    "never_write": []
  },
  "units": {
    "skill": {"frontmatter": "keep", "sidecar": "openai-yaml"},
    "command": {"dir": "~/.codex/prompts", "format": "md-body"},
    "agent": {"dir": "~/.codex/agents", "format": "codex-toml"}
  },
  "hide": {"method": "sidecar", "file": "agents/openai.yaml", "key": "policy.allow_implicit_invocation", "value": false},
  "models": {"source": "the agent files in ~/.codex/agents"},
  "instructions": {"path": "~/.codex/AGENTS.md", "mode": "managed-block"},
  "skill_prefix": "$",
  "effort_syntax": "separate-key",
  "model_surfaces": [
    {"path": "~/.codex/agents/{role}.toml", "consumer": "fleet", "kind": "whole",
     "keys": {"model": "model", "effort": "model_reasoning_effort"}, "text_from": "~/.claude/agents/{role}.md"},
    {"path": "~/.codex/config.toml", "consumer": "codex", "kind": "block", "marker": "rig:models", "table": "agents",
     "keys": {"model": "default_subagent_model", "effort": "default_subagent_reasoning_effort"}},
    {"path": "~/.codex/agents/{role}.toml", "consumer": "agents", "kind": "agent",
     "keys": {"model": "model", "effort": "model_reasoning_effort"}}
  ],
  "budget": {"description_max": 1024, "instructions_max_bytes": 32768},
  "hooks": {"session_end": null},
  "transcripts": {"format": "codex-rollout", "root": "~/.codex/sessions"}
}

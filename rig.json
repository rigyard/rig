{
  "schema": 2,
  "harnesses": [
    "claude",
    "codex",
    "omp",
    "cursor",
    "antigravity"
  ],
  "packs": {
    "cli-for-agent": {},
    "cursor-team-kit": {},
    "product": {},
    "pstack": {}
  },
  "aliases": {},
  "fill": {
    "eng:design": "pstack/architect",
    "eng:ground": "pstack/how",
    "eng:ship.before": [
      "cursor-team-kit/deslop"
    ],
    "prod:discover": "product/office-hours",
    "triggers": [
      {
        "when": "In prod:discover, before research, if two interpretations of the problem change the scope or research questions",
        "use": "pstack/reframe",
        "domain": "product"
      },
      {
        "when": "In eng:ground, before eng:design, if a decision depends on a fact the repository cannot establish",
        "use": "core/engineering-research",
        "domain": "engineering"
      },
      {
        "when": "Building or changing a CLI",
        "use": "cli-for-agent/cli-for-agents",
        "domain": "engineering"
      },
      {
        "when": "Any prose surface, your reply to the user included",
        "use": "pstack/unslop"
      },
      {
        "when": "Docs, RFCs, readmes, PR descriptions, or commit messages",
        "use": "pstack/technical-writing"
      },
      {
        "when": "Before commit",
        "use": "cursor-team-kit/deslop"
      },
      {
        "when": "Before review",
        "use": "pstack/no-comments"
      }
    ]
  },
  "auto": [],
  "disable": [
    "pstack/comment-sicko",
    "pstack/poteto-agent"
  ],
  "metrics": {
    "session_hook": false
  }
}
